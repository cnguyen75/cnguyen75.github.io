{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnguyen75.github.io/data/lately.schema.json",
  "title": "Side D, lately",
  "description": "The single file a nightly job writes for the Lately section. Every panel is optional; the page shows 'not connected yet' for any panel it cannot draw. Times are ISO 8601 with an offset and are displayed in Pacific time.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Version 1. Additive changes keep version 1, so older files still validate. 2026-10-13: rankings lists hold up to ten titles (were five); main_lifts[].best gains optional best_set (which may carry source: manual). 2026-10-13, later: optional top-level analysis (statistics computed from the archive), merged from the pipeline's analysis.schema.json; the lately/ pages draw it."
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "sample": {
      "type": "boolean",
      "description": "True for placeholder data. The page also treats data/lately.sample.json as sample regardless of this flag."
    },
    "sources": {
      "type": "object",
      "description": "One entry per feed, keyed by a short id. Chips are shown in key order.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "fantasy": {
      "$ref": "#/$defs/fantasy"
    },
    "watching": {
      "$ref": "#/$defs/watching"
    },
    "listening": {
      "$ref": "#/$defs/listening"
    },
    "eating": {
      "$ref": "#/$defs/eating"
    },
    "lifting": {
      "$ref": "#/$defs/lifting"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "status",
        "schedule",
        "updated_at",
        "last_ok_at"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Display name, e.g. 'last.fm'."
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "stale",
            "pending",
            "disabled"
          ],
          "description": "ok: the last run succeeded. error: the last run failed. stale: no run within the expected schedule. pending: not connected yet (e.g. awaiting API approval). disabled: switched off."
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short public text shown instead of the status word when not ok, e.g. 'awaiting approval'. Never put error details or secrets here."
        },
        "schedule": {
          "enum": [
            "nightly",
            "weekly"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/nullableTimestamp",
          "description": "When the job last attempted this source."
        },
        "last_ok_at": {
          "$ref": "#/$defs/nullableTimestamp",
          "description": "When this source last succeeded. Null means it never has. When status is not ok, the panel data is from this time."
        }
      }
    },
    "fantasy": {
      "type": "object",
      "required": [
        "season",
        "week",
        "sources",
        "headline",
        "teams",
        "top_players"
      ],
      "additionalProperties": false,
      "properties": {
        "season": {
          "type": "integer"
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "description": "The upcoming or current week. Results cover weeks 1 to week - 1."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Source ids contributing to this panel, in display order."
        },
        "headline": {
          "type": "object",
          "required": [
            "wins",
            "losses",
            "team_count",
            "wins_above_expected",
            "favoured",
            "favoured_of"
          ],
          "additionalProperties": false,
          "properties": {
            "wins": {
              "$ref": "#/$defs/count"
            },
            "losses": {
              "$ref": "#/$defs/count"
            },
            "ties": {
              "$ref": "#/$defs/count"
            },
            "team_count": {
              "$ref": "#/$defs/count"
            },
            "wins_above_expected": {
              "type": "number",
              "description": "Actual wins minus all-play expected wins, summed over teams."
            },
            "favoured": {
              "$ref": "#/$defs/count",
              "description": "Teams favoured this week by projected points."
            },
            "favoured_of": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "teams": {
          "type": "array",
          "description": "Colin's own teams only. Never include other managers' names or team names.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source",
              "wins",
              "losses",
              "results",
              "luck",
              "win_probability"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "description": "Key into sources, e.g. 'espn'."
              },
              "league_label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Shown after the platform, e.g. 'league 1'."
              },
              "wins": {
                "$ref": "#/$defs/count"
              },
              "losses": {
                "$ref": "#/$defs/count"
              },
              "ties": {
                "$ref": "#/$defs/count"
              },
              "results": {
                "type": "array",
                "items": {
                  "enum": [
                    "W",
                    "L",
                    "T"
                  ]
                },
                "description": "Weekly results, week 1 first."
              },
              "luck": {
                "type": "number",
                "description": "Wins versus expected for this team."
              },
              "win_probability": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1,
                "description": "Chance to win the current week, or null when it can't be estimated. When null the page shows win_probability_note, or 'not available this week' if there is no note."
              },
              "win_probability_note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional short public text shown in place of the win-chance bar when win_probability is null (e.g. 'too few weeks'). Ignored when win_probability is a number."
              }
            }
          }
        },
        "top_players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "points_above_replacement"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "points_above_replacement": {
                "type": "number",
                "description": "Points above a replacement starter per game played. Can be negative."
              }
            }
          }
        }
      }
    },
    "watching": {
      "type": "object",
      "required": [
        "source",
        "weeks",
        "recent"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "weeks": {
          "type": "array",
          "description": "Hours per week by type, oldest week first; the last entry is this week. The page's total is the sum of these, so there is no separate total field.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "films",
              "shows",
              "anime"
            ],
            "additionalProperties": false,
            "properties": {
              "films": {
                "type": "number",
                "minimum": 0
              },
              "shows": {
                "type": "number",
                "minimum": 0
              },
              "anime": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "type",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "film",
                  "show",
                  "anime"
                ]
              },
              "season": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "rating": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1,
                "maximum": 10
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://simkl\\.com/",
                "description": "The title's Simkl page (required by Simkl's attribution terms)."
              },
              "status": {
                "enum": [
                  "watched",
                  "finished"
                ],
                "description": "'finished': marked complete in bulk on Simkl, so there is no watch date or season. Finished items always come after watched ones."
              }
            }
          }
        },
        "currently_watching": {
          "type": "array",
          "maxItems": 10,
          "description": "Shows and anime with status 'watching', most recent activity first, with the season and episode reached.",
          "items": {
            "type": "object",
            "required": [
              "title",
              "type",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "show",
                  "anime"
                ]
              },
              "season": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "episode": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://simkl\\.com/",
                "description": "The title's Simkl page."
              }
            }
          }
        },
        "rankings": {
          "type": "object",
          "description": "My top ten of each ranking, best first. The page shows the first five, with a toggle for the rest. Every title links to its Simkl page.",
          "required": [
            "films",
            "shows",
            "anime"
          ],
          "additionalProperties": false,
          "properties": {
            "films": {
              "$ref": "#/$defs/ranked_list"
            },
            "shows": {
              "$ref": "#/$defs/ranked_list"
            },
            "anime": {
              "$ref": "#/$defs/ranked_list"
            }
          }
        }
      }
    },
    "listening": {
      "type": "object",
      "required": [
        "source",
        "top_artists",
        "plays_by_hour"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "plays_this_month": {
          "$ref": "#/$defs/count",
          "description": "Deprecated and ignored. The page shows the sum of plays_by_hour, so the total and the hour chart cover the same last 30 days."
        },
        "top_artists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "plays"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "plays": {
                "$ref": "#/$defs/count"
              }
            }
          },
          "description": "Top artists over the last 30 days, most played first."
        },
        "plays_by_hour": {
          "type": "array",
          "description": "Plays in the last 30 days by local hour of day, 0:00 first. Their sum is shown as 'Plays, last 30 days'.",
          "items": {
            "$ref": "#/$defs/count"
          },
          "minItems": 24,
          "maxItems": 24
        }
      }
    },
    "eating": {
      "type": "object",
      "required": [
        "source",
        "ranked_count",
        "recent",
        "cuisines"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "ranked_count": {
          "$ref": "#/$defs/count"
        },
        "recent": {
          "type": "array",
          "maxItems": 10,
          "description": "The ten restaurants most recently ranked on Beli, newest first. No dates or relative times are published; the order is the only signal.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "city",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Beli score, shown with two decimals."
              }
            }
          }
        },
        "cuisines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "$ref": "#/$defs/count"
              }
            }
          },
          "description": "Places ranked per cuisine. The page draws at most six named cuisines as bars, scaled to the largest named one. Anything beyond six, and any entry named 'Other', becomes a text line under the chart: 'plus N across K other cuisines' when the individual cuisines are listed, or 'Other: N' when the file only gives a lumped 'Other' count."
        }
      }
    },
    "ranked_list": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://simkl\\.com/"
          }
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A calendar date, YYYY-MM-DD (Pacific)."
    },
    "lifting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "unit",
        "data_through",
        "first_workout",
        "workout_count",
        "main_lifts",
        "weeks",
        "streak_weeks",
        "streak_min_sessions",
        "recent_prs",
        "muscle_sets",
        "body_weight"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "unit": {
          "enum": [
            "lb",
            "kg"
          ],
          "description": "Unit for every weight and volume in this section."
        },
        "data_through": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date (Pacific) of the newest workout included. Show as 'data through …'."
        },
        "first_workout": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the first workout in the history."
        },
        "workout_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Workouts in the whole history."
        },
        "main_lifts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "exercise",
              "machine",
              "sessions",
              "current",
              "best",
              "history"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Movement pattern label, e.g. 'Squat'."
              },
              "exercise": {
                "type": "string",
                "description": "Hevy exercise name, e.g. 'Hack Squat (Machine)'."
              },
              "machine": {
                "type": "boolean",
                "description": "True for machine and cable variants, so the site can label them."
              },
              "sessions": {
                "type": "integer",
                "minimum": 1,
                "description": "Sessions with this lift. Below three, the page shows 'n sessions so far' in place of the trend chart."
              },
              "current": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "e1rm",
                  "weight",
                  "reps"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "e1rm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  },
                  "reps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "description": "Estimated one-rep max from the most recent session (Epley, best working set of 1-10 reps), with that set."
              },
              "best": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "e1rm"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "e1rm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "best_set": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "weight_lb",
                      "reps",
                      "date"
                    ],
                    "properties": {
                      "weight_lb": {
                        "type": "number",
                        "minimum": 0
                      },
                      "reps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "date": {
                        "$ref": "#/$defs/date"
                      },
                      "source": {
                        "const": "manual",
                        "description": "Optional. Present only when the set was entered by hand rather than coming from Hevy; the page tags it 'logged by hand'."
                      }
                    },
                    "description": "Optional. The set behind the best, in pounds whatever `unit` says. Shown under the best as 'best set 185 × 4 · 26 Sep'."
                  }
                },
                "description": "Highest estimated one-rep max in the history."
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "e1rm"
                  ],
                  "properties": {
                    "date": {
                      "$ref": "#/$defs/date"
                    },
                    "e1rm": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "description": "Estimated one-rep max per session, oldest first, for a sparkline."
              }
            }
          },
          "description": "One entry per main lift (one exercise per movement pattern), in display order."
        },
        "weeks": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "week_start",
              "sessions",
              "volume"
            ],
            "properties": {
              "week_start": {
                "$ref": "#/$defs/date"
              },
              "sessions": {
                "type": "integer",
                "minimum": 0
              },
              "volume": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "The last 12 weeks, oldest first; weeks start on Monday (Pacific). The last one is the current, unfinished week. volume = weight × reps over working sets."
        },
        "streak_weeks": {
          "type": "integer",
          "minimum": 0,
          "description": "Consecutive weeks with at least streak_min_sessions workouts, counting back from this week; an unfinished week doesn't break it."
        },
        "streak_min_sessions": {
          "type": "integer",
          "minimum": 1,
          "description": "Workouts a week needs to count towards the streak."
        },
        "recent_prs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "exercise",
              "kind",
              "value",
              "measure",
              "reps"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "exercise": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "weight",
                  "e1rm",
                  "set_volume",
                  "reps",
                  "duration",
                  "distance"
                ]
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "measure": {
                "enum": [
                  "lb",
                  "kg",
                  "reps",
                  "seconds",
                  "metres"
                ]
              },
              "reps": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "description": "Personal records from the last 30 days, newest first, one per exercise and kind (Hevy's own PR markers). value is in `unit` when measure is the unit, else reps, seconds or metres."
        },
        "muscle_sets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weeks",
            "groups"
          ],
          "properties": {
            "weeks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/date"
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "muscle",
                  "sets"
                ],
                "properties": {
                  "muscle": {
                    "type": "string"
                  },
                  "sets": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "description": "Working sets per primary muscle group (Hevy's labels, e.g. upper_back) for the last 4 weeks; sets[i] belongs to weeks[i]. Cardio left out. groups sorted by total, largest first."
        },
        "body_weight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latest",
            "history"
          ],
          "properties": {
            "latest": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "weight"
                  ],
                  "properties": {
                    "date": {
                      "$ref": "#/$defs/date"
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "weight"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/$defs/date"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "description": "Body weight measurements from Hevy, full precision to 0.1, oldest first in history."
        }
      },
      "description": "Strength training from Hevy, collected on my Mac nightly. All weights are in `unit`. The source chip's last_ok_at says when it last updated; data_through is the newest workout's date."
    },
    "analysis_stat": {
      "type": "object",
      "additionalProperties": false,
      "description": "One statistic. With a status other than \"ok\" there is no value, values or interval: nothing is published but the reason.",
      "required": [
        "status",
        "n",
        "min_n",
        "as_of",
        "how"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "not enough data yet",
            "not available from source",
            "not configured"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "The headline number, when there is one."
        },
        "values": {
          "type": "object",
          "description": "The statistic's figures; each one's shape is in analysis.sample.json."
        },
        "interval": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "95% interval for value, where one is defined."
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Sample size, in the unit min_n counts (weeks, plays, sessions, places...)."
        },
        "min_n": {
          "type": "integer",
          "minimum": 0
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "how": {
          "type": "string",
          "minLength": 1,
          "description": "One plain sentence: how it is computed."
        },
        "missing": {
          "type": "string",
          "description": "Unless ok: the archive field or setting that is lacking."
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of"
      ],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/date"
