        },
        "cross": {
          "$ref": "#/$defs/analysis_cross"
        },
        "grading": {
          "$ref": "#/$defs/analysis_grading"
        }
      },
      "description": "Statistics computed from the archive: one block per feed plus cross and grading. Opponents are never named; Beli dates never appear."
    },
